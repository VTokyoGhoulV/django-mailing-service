# PostgreSQL: create this database and user before running migrations.
NAME=mailing_service
USER=mailing_user
PASSWORD=replace_with_database_password
HOST=127.0.0.1
PORT=5432

# SMTP: use a test mailbox while trying the application.
# TLS is enabled in config/settings.py.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=demo@example.com
EMAIL_HOST_PASSWORD=replace_with_smtp_password
EMAIL_RECIPIENT=demo@example.com
